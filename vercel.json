{
  "rewrites": [
    {
      "source": "/herenkapper",
      "destination": "/herenkapper.html"
    },
    {
      "source": "/barbier",
      "destination": "/barbier.html"
    },
    {
      "source": "/waxen",
      "destination": "/waxen.html"
    },
    {
      "source": "/gezichtsbehandeling",
      "destination": "/gezichtsbehandeling.html"
    },
    {
      "source": "/massages",
      "destination": "/massages.html"
    },
    {
      "source": "/scheerwinkel",
      "destination": "/scheerwinkel.html"
    },
    {
      "source": "/team",
      "destination": "/team.html"
    },
    {
      "source": "/over-ons",
      "destination": "/over-ons.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
